{
  "panelId": "geo-json-layer-manager",
  "panelName": "GeoJSON图层管理",
  "panelIcon": "🗺️",
  "configId": "geojson-layers",
  
  "featureFolder": "GeoJsonLayerManager",
  
  "fieldDefinitions": [
    { "key": "id", "label": "ID", "type": "text", "required": true, "placeholder": "唯一标识符", "readonly": true, "hidden": true },
    { "key": "name", "label": "图层名称", "type": "text", "required": true, "placeholder": "图层名称" },
    { "key": "description", "label": "描述", "type": "text", "required": false, "placeholder": "图层描述" },
    { 
      "key": "geoType", 
      "label": "几何类型", 
      "type": "select", 
      "required": true,
      "options": [
        { "value": "Point", "label": "点" },
        { "value": "LineString", "label": "线" },
        { "value": "Polygon", "label": "面" }
      ]
    },
    { "key": "geoJson", "label": "GeoJSON数据", "type": "textarea", "required": true, "placeholder": "GeoJSON格式数据" },
    { "key": "fillColor", "label": "填充颜色", "type": "text", "required": false, "default": "#FFFF00" },
    { "key": "strokeColor", "label": "边框颜色", "type": "text", "required": false, "default": "#000000" },
    { "key": "strokeWidth", "label": "边框宽度", "type": "number", "required": false, "default": 2 },
    { "key": "markerIcon", "label": "点图标", "type": "text", "required": false, "default": "", "placeholder": "留空=渐变圆点 | 单字符=PinBuilder文字 | emoji/SVG=自定义图标" },
    { "key": "markerColor", "label": "点颜色", "type": "text", "required": false, "default": "#4169E1" },
    { "key": "markerSize", "label": "点大小", "type": "number", "required": false, "default": 48 },
    { "key": "clampToGround", "label": "是否贴地", "type": "boolean", "required": false, "default": true },
    { "key": "labelField", "label": "标注字段", "type": "text", "required": false, "placeholder": "feature.properties中的字段名，如：name" },
    { "key": "labelFontSize", "label": "标注字号(px)", "type": "number", "required": false, "default": 28 },
    { "key": "labelScale", "label": "标注缩放", "type": "number", "required": false, "default": 1.2 },
    { "key": "labelColor", "label": "标注颜色", "type": "text", "required": false, "default": "#a6fd1c" },
    { "key": "labelVisibleMin", "label": "标注可见最近距离(m)", "type": "number", "required": false, "default": 0 },
    { "key": "labelVisibleMax", "label": "标注可见最远距离(m)", "type": "number", "required": false, "default": 50000 },
    { "key": "clusterEnabled", "label": "开启点聚类", "type": "boolean", "required": false, "default": false },
    { "key": "clusterPixelRange", "label": "聚类半径(px)", "type": "number", "required": false, "default": 50 },
    { "key": "clusterMinSize", "label": "最少聚合点数", "type": "number", "required": false, "default": 3 },
    { "key": "heatmapEnabled", "label": "开启热力图（仅点图层）", "type": "boolean", "required": false, "default": false },
    { "key": "heatmapBlur", "label": "热力图模糊半径(px)", "type": "number", "required": false, "default": 30 },
    { "key": "heatmapRadius", "label": "热力图点半径(px)", "type": "number", "required": false, "default": 20 },
    { "key": "heatmapOpacity", "label": "热力图不透明度(0-1)", "type": "number", "required": false, "default": 0.8 },
    { "key": "heatmapValueField", "label": "热力值字段", "type": "text", "required": false, "placeholder": "feature.properties中的数值字段名，如：population" },
    { "key": "heatmapGradient", "label": "热力图渐变配色(JSON)", "type": "textarea", "required": false, "placeholder": "{\"0.0\":\"rgba(0,0,255,0)\",\"0.4\":\"cyan\",\"0.7\":\"yellow\",\"1.0\":\"red\"}" }
  ],
  "defaultFormValues": {
    "id": "",
    "name": "",
    "description": "",
    "geoType": "Point",
    "geoJson": "{\"type\": \"FeatureCollection\", \"features\": []}",
    "fillColor": "#FFFF00",
    "strokeColor": "#000000",
    "strokeWidth": 2,
    "markerColor": "#4169E1",
    "markerIcon": "",
    "markerSize": 48,
    "clampToGround": true,
    "labelField": "name",
    "labelFontSize": 28,
    "labelScale": 1.2,
    "labelColor": "#a6fd1c",
    "labelVisibleMin": 0,
    "labelVisibleMax": 50000,
    "clusterEnabled": false,
    "clusterPixelRange": 50,
    "clusterMinSize": 3,
    "heatmapEnabled": false,
    "heatmapBlur": 40,
    "heatmapRadius": 35,
    "heatmapOpacity": 0.85,
    "heatmapValueField": "",
    "heatmapGradient": ""
  },
  "toolbarButtons": {
    "add": true,
    "import": true,
    "export": true,
    "refresh": true
  },
  "dataSource": {
    "type": "sqlite",
    "tableName": "GeoJsonLayerManager",
    "primaryKey": "id",
    "fileName": "GeoJsonLayerManager",
    "relativePath": "gis/GeoJsonLayerManager/GeoJsonLayerManager.json"
  }
}